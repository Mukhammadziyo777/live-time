<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Live Time Tracker</title>

<style>

/* ===== BODY ===== */
body{
    margin:0;
    font-family:Arial, Helvetica, sans-serif;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    color:white;
}

/* ===== CARD ===== */
.container{
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(15px);
    padding:40px;
    border-radius:20px;
    text-align:center;
    width:350px;
    box-shadow:0 0 25px rgba(0,0,0,0.5);
}

/* ===== TIME ===== */
#time{
    font-size:48px;
    font-weight:bold;
    margin:20px 0;
}

/* ===== DATE ===== */
#date{
    font-size:18px;
    opacity:0.8;
}

/* ===== EMAIL FORM ===== */
input{
    width:90%;
    padding:12px;
    margin-top:20px;
    border:none;
    border-radius:10px;
    outline:none;
    font-size:16px;
}

button{
    margin-top:15px;
    padding:12px 20px;
    border:none;
    border-radius:10px;
    background:#00c6ff;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#0072ff;
    transform:scale(1.05);
}

/* SUCCESS TEXT */
#message{
    margin-top:15px;
    color:#00ffcc;
}

</style>
</head>

<body>

<div class="container">

<h2>⏱ Live Time Tracker</h2>

<div id="time">00:00:00</div>
<div id="date">Loading...</div>

<input type="email" id="email" placeholder="Enter your email">
<br>
<button onclick="saveEmail()">Submit</button>

<p id="message"></p>

</div>

<script>

/* ===== LIVE TIME ===== */
function updateTime(){
    const now = new Date();

    let hours = String(now.getHours()).padStart(2,'0');
    let minutes = String(now.getMinutes()).padStart(2,'0');
    let seconds = String(now.getSeconds()).padStart(2,'0');

    document.getElementById("time").innerText =
        `${hours}:${minutes}:${seconds}`;

    document.getElementById("date").innerText =
        now.toDateString();
}

setInterval(updateTime,1000);
updateTime();

/* ===== EMAIL SAVE ===== */
function saveEmail(){
    let email = document.getElementById("email").value;

    if(email === ""){
        alert("Email kiriting!");
        return;
    }

    localStorage.setItem("userEmail", email);

    document.getElementById("message").innerText =
        "✅ Email saved successfully!";
}

</script>

</body>
</html>